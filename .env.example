NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# MySQL via Laragon — utf8mb4_unicode_ci
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If password is empty (default Laragon): mysql://root:@127.0.0.1:3306/closette_db
DATABASE_URL="mysql://root:@127.0.0.1:3306/closette_db"

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_long_random_secret_at_least_64_chars

# CORS
FRONTEND_URL=http://localhost:5173

# ─── NEBIUS / NVIDIA AI ───────────────────────────────────────────────────────
# Get your API key at: https://studio.nebius.com/
# Model IDs verified on Nebius (check availability before use):
# - nvidia/llama-3.1-nemotron-70b-instruct (text/outfit recommendations)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct

# ─── IMAGE STORAGE ────────────────────────────────────────────────────────────
IMAGE_STORAGE_MODE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─── VIRTUAL TRY-ON ──────────────────────────────────────────────────────────
# Supported providers: none | fashn | replicate
# Leave empty to run app without try-on (honest state shown to user)
VTON_PROVIDER=
VTON_API_KEY=
VTON_MODEL_ID=

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── EMAIL SERVICE (SMTP) ─────────────────────────────────────────────────────
# Used for password reset and notifications to real user emails.
# For Gmail:
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Paste your 16-character App Password into SMTP_PASS (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="CLOSETTE Fashion" <noreply@closette.app>
